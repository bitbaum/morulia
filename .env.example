# Every variable this service reads. Real values live in the box env
# (/opt/morulia/shared/.env) — never in git. An empty provider pair switches
# that provider OFF and removes its button; it never breaks the page.

# ── Required in production (the service refuses to start without them) ──────
# The public origin. It IS the OIDC issuer every app puts in SIGNIN_ISSUER,
# compared byte for byte: no trailing slash. In production:
# https://morulia.orangecat.ch
SIGNIN_URL=
DATABASE_URL=
# Signs this service's own sessions and the signed authorize query.
#   openssl rand -base64 48
BETTER_AUTH_SECRET=
# Derives each app's pairwise subject. NEVER ROTATE: changing it changes every
# person's identifier in every app at once.
#   openssl rand -base64 48
SIGNIN_PAIRWISE_SECRET=

# ── One secret per registered app (lib/clients.ts) ──────────────────────────
# The same value as that app's SIGNIN_CLIENT_SECRET. Written on the box by
# loki scripts/hetzner/app-secrets.sh, never pasted. An app without one is
# stored switched off and /api/health counts it as not active.
SIGNIN_CLIENT_SECRET_BIASLENS=
SIGNIN_CLIENT_SECRET_CAUSIUS=
SIGNIN_CLIENT_SECRET_DIPLODOCTOR=
SIGNIN_CLIENT_SECRET_HEIDI=
SIGNIN_CLIENT_SECRET_HIRNLI=
SIGNIN_CLIENT_SECRET_SOLON=
SIGNIN_CLIENT_SECRET_SUBSTRATA=

# ── Upstream providers, each held ONCE here for every app ───────────────────
# Do not paste these on the box: paste them as repository secrets of
# bitbaum/morulia under the same names, and .github/workflows/provider-keys.yml
# writes them here (docs/providers.md has every provider's steps).
# Callback for each: <SIGNIN_URL>/api/auth/callback/<id>, with <id> one of
# google apple microsoft facebook github linkedin twitter discord gitlab slack
# twitch reddit.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple (paid: Apple Developer Program). The Services ID, the team, and a Sign
# in with Apple key (.p8 contents; literal \n is accepted). The client secret
# JWT is minted from these.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Microsoft: an Entra app registration for any tenant + personal accounts.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Meta: a Facebook Login app.
META_APP_ID=
META_APP_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# LinkedIn: the "Sign In with LinkedIn using OpenID Connect" product.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# X (paid: pay-per-use API): an OAuth 2.0 client (not the 1.0a consumer key),
# type "Web App".
X_CLIENT_ID=
X_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Reddit: a "web app"; Reddit may require approval first.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
